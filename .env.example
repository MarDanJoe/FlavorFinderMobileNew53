# Public app configuration (safe to bundle; these are NOT service-role keys)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional; defaults to the Supabase places Edge Function when URL is present
EXPO_PUBLIC_PLACES_API_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_DEMO_MODE=false
# Set after deciding your Apple identity and running eas init
IOS_BUNDLE_IDENTIFIER=
EAS_PROJECT_ID=

# Server only: set as a Supabase function secret, never EXPO_PUBLIC_
GOOGLE_PLACES_API_KEY=
GOOGLE_DAILY_REQUEST_LIMIT=100
